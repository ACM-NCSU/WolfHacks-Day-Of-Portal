# Copy this file to .env (Vite loads .env automatically) and fill in real
# values. Never commit .env.

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=
# The anon/publishable key (safe to expose to the frontend) -- not the
# service role key, which stays backend-only.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local-only auth bypass ---
# Supabase's Discord OAuth redirect goes to a single Site URL, so it can't
# point at localhost and the deployed domain at the same time. Set this to
# skip the portal's login gate entirely and use a fake signed-in participant
# instead, so you can work on portal UI locally without fighting OAuth.
# Never set this in a deployed environment -- it's also hard-gated on
# import.meta.env.DEV in usePortalSession.js as a second safety net.
# VITE_SKIP_AUTH=true
# 'hacker' (default) or 'organizer' -- controls which nav tabs show up.
# VITE_SKIP_AUTH_ROLE=hacker
