# Copy this file to .env (Vite loads .env automatically) and fill in real
# values. Never commit .env.

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=
# The anon/publishable key (safe to expose to the frontend) -- not the
# service role key, which stays backend-only.
VITE_SUPABASE_PUBLISHABLE_KEY=
